# Auto detect text files and perform LF normalization
* text=auto

# Force LF for scripts and source
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.in text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Force CRLF for Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.bin binary
*.pt binary
*.safetensors binary

# Lock files - do not merge
requirements.lock merge=ours
tools.lock.json merge=ours
model.lock.json merge=ours
